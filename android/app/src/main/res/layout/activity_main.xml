<!--
  单界面，卡片式布局：连接 / 功能 / 远程输入 / 后台保活 / 更新，最后是可折叠的诊断区
  （连接读数 + 日志，默认收起，标题行点击展开）。唯一滚动区域是这一个 ScrollView；
  布局里不放任何计算逻辑。

  **不用固定高度**：每张卡片 `wrap_content`，内容随语言/字号自然伸缩（AGENTS §1.3
  「界面不要写死高度」）。需要「数值不跳动」的地方靠等宽字体（PvStatus 用 monospace）。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 品牌头图：渐变底 + 大标题 + 实时连接状态。比裸文字标题更像一个应用。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_hero"
            android:elevation="2dp"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="@string/app_name"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/subtitle"
                android:textColor="#CCE0FF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvHeroStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_chip"
                android:fontFamily="monospace"
                android:paddingStart="12dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp"
                android:paddingBottom="5dp"
                android:text="@string/msg_not_connected"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- ============================ 连接 ============================ -->
        <com.google.android.material.card.MaterialCardView
            style="@style/PvCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/PvCardTitle"
                    android:text="@string/section_connect" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etHost"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:autofillHints=""
                        android:background="@drawable/bg_field"
                        android:hint="@string/hint_host"
                        android:importantForAutofill="no"
                        android:inputType="textUri"
                        android:maxLines="1"
                        android:minHeight="48dp"
                        android:padding="12dp"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btnConnect"
                        style="@style/PvButton"
                        android:layout_width="wrap_content"
                        android:layout_marginStart="8dp"
                        android:minWidth="88dp"
                        android:text="@string/btn_connect" />
                </LinearLayout>

                <!--
                  「重新发现」与「重新连接」是**两件事**，所以是两个按钮（DESIGN.md §4.1.1）：
                    重新发现 = 换了 Wi-Fi / 刚才没搜到 → 停掉 NsdManager 再 discover（要等几秒）
                    重新连接 = 只是掉线、服务还在    → 只重连 WebSocket（立刻就好）
                  分开是为了让用户在正确的时机做正确的事：只是掉线却去重新发现，会白等那几秒。
                  电脑上没跑服务时搜不到是**预期行为**，所以这两个按钮任何时候都可用。
                -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnRediscover"
                        style="@style/PvButton.Outlined"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/btn_rediscover" />

                    <Button
                        android:id="@+id/btnReconnect"
                        style="@style/PvButton.Outlined"
                        android:layout_width="0dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/btn_reconnect" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnHealth"
                    style="@style/PvButton.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_health" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============================ 功能 ============================ -->
        <com.google.android.material.card.MaterialCardView
            style="@style/PvCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/PvCardTitle"
                    android:text="@string/section_function" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swMic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/sw_mic"
                    android:textSize="14sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilMicSource"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/mic_source_label"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/spMicSource"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:minHeight="52dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/mic_source_hint"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="11sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swSpeaker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/sw_speaker"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ========================= 远程输入 ========================= -->
        <com.google.android.material.card.MaterialCardView
            style="@style/PvCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/PvCardTitle"
                    android:text="@string/section_input" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swRemote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/sw_remote"
                    android:textSize="14sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swRemoteText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:minHeight="44dp"
                    android:text="@string/sw_remote_text"
                    android:textSize="13sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swRemoteKeys"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:minHeight="44dp"
                    android:text="@string/sw_remote_keys"
                    android:textSize="13sp" />

                <!-- 输入框：承接输入法已组合文本；空框里按退格会把删除键转发给电脑 -->
                <com.purevox.mic.PvEditText
                    android:id="@+id/etText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints=""
                    android:background="@drawable/bg_field"
                    android:hint="@string/hint_text_local"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="6"
                    android:minHeight="56dp"
                    android:padding="12dp"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnSend"
                        style="@style/PvButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/btn_send" />

                    <Button
                        android:id="@+id/btnClear"
                        style="@style/PvButton.Outlined"
                        android:layout_width="0dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/btn_clear" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ========================= 后台保活 ========================= -->
        <com.google.android.material.card.MaterialCardView
            style="@style/PvCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/PvCardTitle"
                    android:text="@string/section_keepalive" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/keepalive_desc"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp" />

                <!-- 常驻通知状态：挂了 / 没挂上（带原因）。看不见的「保活没生效」= 没有保活 -->
                <TextView
                    android:id="@+id/tvKeepalive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/keepalive_notif_off"
                    android:textSize="12sp" />

                <!-- 通知权限（Android 13+）：没允许就没通知；一旦拒过，弹窗不会再出现，只能去设置 -->
                <TextView
                    android:id="@+id/tvNotifPerm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/notif_perm_unknown"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnNotifSettings"
                    style="@style/PvButton.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_notif_settings" />

                <TextView
                    android:id="@+id/tvBattery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/battery_not_ignored"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnBattery"
                    style="@style/PvButton.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_battery_settings" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- =========================== 更新 =========================== -->
        <com.google.android.material.card.MaterialCardView
            style="@style/PvCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/PvCardTitle"
                    android:text="@string/section_update" />

                <TextView
                    android:id="@+id/tvUpdate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnCheckUpdate"
                    style="@style/PvButton.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_check_update" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnDownload"
                        style="@style/PvButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:enabled="false"
                        android:text="@string/btn_download" />

                    <Button
                        android:id="@+id/btnInstall"
                        style="@style/PvButton"
                        android:layout_width="0dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:enabled="false"
                        android:text="@string/btn_install" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ================= 诊断（默认收起，标题行点击展开） ================= -->
        <!-- 标题行给一块可见底板（bg_panel + 前景 ripple），否则它只是一行彩色小字，
             看不出能点（「调试看问题不够」的一半原因是它根本不像入口）。 -->
        <TextView
            android:id="@+id/tvDiagHeader"
            style="@style/PvCardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_panel"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:text="@string/diag_show" />

        <LinearLayout
            android:id="@+id/llDiag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- 实时监控 · 网络：RTT 窗口统计 + 抖动 + 真实速率（字节差分，不拿设定比特率冒充） -->
            <TextView
                style="@style/PvCardTitle"
                android:layout_marginTop="10dp"
                android:text="@string/diag_net" />

            <TextView
                android:id="@+id/tvNet"
                style="@style/PvStatus" />

            <!--
              实时监控 · 音频：电平与缓冲水位用条（数值仍等宽写在右侧，不跳布局）。

              `trackStopIndicatorSize="0dp"` 是**必须**的：Material 3 默认会在轨道末端画一个
              「停止指示点」，电平为 0（未开启 / 静音）时看着就像条上浮了个点、像是渲染坏了
              —— 2026-10-18 在模拟器截图里实测到。三条都要关。
            -->
            <TextView
                style="@style/PvCardTitle"
                android:layout_marginTop="12dp"
                android:text="@string/diag_audio" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="@string/diag_level_up"
                    android:textSize="11sp" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/pbUpLevel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    app:indicatorColor="@color/pv_accent"
                    app:trackColor="?attr/colorSurfaceVariant"
                    app:trackCornerRadius="2dp"
                    app:trackStopIndicatorSize="0dp"
                    app:trackThickness="6dp" />

                <TextView
                    android:id="@+id/tvUpLevel"
                    android:layout_width="92dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="@string/diag_level_down"
                    android:textSize="11sp" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/pbDownLevel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    app:indicatorColor="@color/pv_accent"
                    app:trackColor="?attr/colorSurfaceVariant"
                    app:trackCornerRadius="2dp"
                    app:trackStopIndicatorSize="0dp"
                    app:trackThickness="6dp" />

                <TextView
                    android:id="@+id/tvDownLevel"
                    android:layout_width="92dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="@string/diag_buffer"
                    android:textSize="11sp" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/pbBuffer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    app:indicatorColor="@color/pv_accent"
                    app:trackColor="?attr/colorSurfaceVariant"
                    app:trackCornerRadius="2dp"
                    app:trackStopIndicatorSize="0dp"
                    app:trackThickness="6dp" />

                <TextView
                    android:id="@+id/tvBuffer"
                    android:layout_width="92dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAudio"
                style="@style/PvStatus"
                android:layout_marginTop="6dp" />

            <Button
                android:id="@+id/btnCopyDiag"
                style="@style/PvButton.Outlined"
                android:layout_width="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/btn_copy_diag" />

            <TextView
                android:id="@+id/tvStatus"
                style="@style/PvStatus"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/tvHealth"
                style="@style/PvStatus"
                android:layout_marginTop="6dp"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvErr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/pv_err"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
