<!--
  设置弹出层（BottomSheetDialog）。头图右上角的圆点按钮打开。

  这里只放**不需要一直看着**的东西：后台保活、应用内更新、关于。
  连接 / 音频 / 诊断读数仍留在主页面 —— 它们是「现在正在发生什么」，
  不该藏在一次点击之后。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="10dp"
    android:paddingEnd="18dp"
    android:paddingBottom="18dp">

    <!-- 拖动指示条：Material 的弹出层习惯，不占交互 -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/sheet_title"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSheetClose"
            style="@style/PvButton.Outlined"
            android:layout_width="wrap_content"
            android:text="@string/sheet_close" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ========================= 后台保活 ========================= -->
            <TextView
                style="@style/PvCardTitle"
                android:layout_marginTop="8dp"
                android:text="@string/section_keepalive" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/keepalive_desc"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvKeepalive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/keepalive_notif_off"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvNotifPerm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/notif_perm_unknown"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnNotifSettings"
                style="@style/PvButton.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/btn_notif_settings" />

            <TextView
                android:id="@+id/tvBattery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/battery_not_ignored"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnBattery"
                style="@style/PvButton.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/btn_battery_settings" />

            <!-- =========================== 更新 =========================== -->
            <TextView
                style="@style/PvCardTitle"
                android:layout_marginTop="18dp"
                android:text="@string/section_update" />

            <TextView
                android:id="@+id/tvUpdate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnCheckUpdate"
                style="@style/PvButton.Outlined"
                android:layout_width="match_parent"
                android:layout_marginTop="8dp"
                android:text="@string/btn_check_update" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnDownload"
                    style="@style/PvButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="@string/btn_download" />

                <Button
                    android:id="@+id/btnInstall"
                    style="@style/PvButton"
                    android:layout_width="0dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="@string/btn_install" />
            </LinearLayout>

            <!-- =========================== 关于 =========================== -->
            <TextView
                style="@style/PvCardTitle"
                android:layout_marginTop="18dp"
                android:text="@string/section_about" />

            <TextView
                android:id="@+id/tvAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/about_license"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
