{
  "productName": "PureVox",
  "version": "0.1.0",
  "identifier": "com.purevox.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PureVox",
        "width": 1460,
        "height": 840,
        "minWidth": 826,
        "minHeight": 504,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../models/*.onnx": "models/",
      "opus.dll": "opus.dll"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libjavascriptcoregtk-4.1-0",
          "libgtk-3-0",
          "libgdk-pixbuf-2.0-0",
          "libcairo2",
          "libsoup-3.0-0",
          "libglib2.0-0",
          "libdbus-1-3",
          "libasound2",
          "libayatana-appindicator3-1",
          "libgcc-s1",
          "libc6"
        ],
        "recommends": ["libopus0", "pulseaudio-utils"]
      },
      "rpm": {
        "recommends": ["opus", "pulseaudio-utils"]
      }
    }
  }
}
