# PureVox CI 版本与缓存键的唯一来源（workflow 只来这里取值，不各自硬编码）。
# 格式 KEY=VALUE，bash（`. tools/automation/versions.env`）与 pwsh 均可解析。

# 缓存代数：工具链基线 / 依赖升级时手动 +1，旧缓存整体作废重建。
CACHE_GEN=1

# Rust 工具链（rustup 安装；出现上游回归需要钉死时改成如 1.99.0）。
RUST_TOOLCHAIN=stable

# tauri-cli 版本（cargo install --version 钉死；升级时同步改此值，缓存键随之失效）。
TCLI_VER=3.0.0-alpha.4

# 前端类型检查用 TypeScript 版本（与本机 npm i -g typescript@X 保持一致）。
TS_VER=7.0.2

# Node 大版本（setup-node 只钉大版本，补丁随 runner 镜像走）。
NODE_VER=24

# Linux 打包 runner（Tauri 的 Linux 依赖 WebKitGTK 4.1；22.04 出包兼容面更广）。
LINUX_RUNNER=ubuntu-22.04

# Android：JDK 大版本 + SDK 平台 / build-tools。
# 注意本工程**不需要 NDK / CMake**（Opus 走系统 MediaCodec，无 JNI），勿再加。
JDK_VER=17
ANDROID_PLATFORM=android-34
ANDROID_BUILD_TOOLS=34.0.0
