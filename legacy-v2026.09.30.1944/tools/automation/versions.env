#
# Sourced by workflows (via GITHUB_ENV), pack scripts and bootstrap scripts.
# Bump a value here once; every workflow/cache key/download URL follows.
# Shell + ASCII only: also parsed by PowerShell (Get-Content | ConvertFrom-StringData).

# python-build-standalone release used for the embedded Linux Python 3.12
PBS_CPYTHON_VER=3.12.14
PBS_TAG=20260814

# appimagetool (continuous build; pinned by download URL date is not
# possible, so the cache key only versions our side)
APPIMAGETOOL_VER=continuous

# Opus C library source for the Android JNI build
OPUS_VER=1.5.2

# Cache-key generations. Bump the generation (not the component version)
# when the cache layout itself changes (e.g. new paths added to a bucket).
LINUX_CACHE_GEN=v2
WINDOWS_PIP_CACHE_GEN=v2

# Derived bucket keys (workflows compose them from the values above):
#   LINUX:   purevox-linux-cache-<GEN>-cpython-<PBS_CPYTHON_VER>-appimagetool-x64
#   WINDOWS: purevox-windows-pip-<GEN>-<hash(requirements-win.txt)>
#   OPUS:    purevox-android-opus-src-<OPUS_VER>
