  权限说明：
    RECORD_AUDIO                      手机麦克风 -> 电脑（Android 9+ 后台受限，故配前台服务）
    FOREGROUND_SERVICE                 推流期间保持前台服务
    FOREGROUND_SERVICE_MICROPHONE      Android 14+ 的 microphone 前台服务类型
    FOREGROUND_SERVICE_DATA_SYNC       Android 14+：会话保活兼作 dataSync（连接期间常在）
    POST_NOTIFICATIONS                 Android 13+ 前台服务通知可见
    INTERNET / ACCESS_NETWORK_STATE    wss:// 与 https:// /health 自检（电脑端只监听 HTTPS）
    WAKE_LOCK                         推流期间不熄屏（音频线程）
    REQUEST_INSTALL_PACKAGES           应用内更新：把下载好的 APK 交给系统安装器
    REQUEST_IGNORE_BATTERY_OPTIMIZATIONS  应用内更新/推流：请求忽略电池优化（保活）
    CAMERA                            扫码填地址（只在点「扫描」时打开相机，可拒绝）

  组件：
    CaptureService   前台服务（microphone + dataSync），常驻通知带「停止 / 断开」按钮
    FileProvider     应用内更新下载的 APK 通过它交给系统安装器（见 res/xml/file_paths.xml）
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 应用内更新：安装下载好的 APK（Android 8+ 为每应用开关，见 UpdateInstaller） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 保活：请求把本应用排除出电池优化（由用户在系统弹窗里确认） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 扫码填地址：相机只在点「扫描」时用；没有相机也能手动输入 -->
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PureVox"
        android:usesCleartextTraffic="true">

        <!-- 扫码：竖屏 + 正方形四角取景框（PvScanActivity 只替换库的取景层） -->
        <activity
            android:name=".PvScanActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.PureVox.Scan" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.CaptureService"
            android:exported="false"
            android:foregroundServiceType="microphone|dataSync" />

        <!-- 应用内更新：把私有目录里下载好的 APK 通过 FileProvider 交给系统安装器 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>