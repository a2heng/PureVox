# PureVox CI 版本与工具链的唯一来源（workflow 只来这里取值，不各自硬编码）。
# 格式 KEY=VALUE，bash（`. tools/automation/versions.env`）与 pwsh 均可解析。
# **不缓存任何东西**（2026-10-28 起）：没有缓存键，故也没有缓存代数/发行版标记。

# Rust 工具链（rustup 安装；出现上游回归需要钉死时改成如 1.99.0）。
RUST_TOOLCHAIN=stable

# tauri-cli 版本（cargo install --version 钉死；升级时同步改此值）。
TCLI_VER=3.0.0-alpha.5

# 前端类型检查用 TypeScript 版本（与本机 npm i -g typescript@X 保持一致）。
TS_VER=7.0.2

# Node 大版本（setup-node 只钉大版本，补丁随 runner 镜像走）。
NODE_VER=24

# Linux runner —— **一律显式钉 ubuntu-24.04**，不用 `ubuntu-latest`，也不分「测试用新、
# 打包用老」两档。`ubuntu-latest` 指向哪一版由 GitHub 决定，环境从 24.04 变成 26.04 这件事
# **在仓库里没有任何提交可查** —— 不是谁偷偷改的，是压根没有记录。曾经照着「ubuntu-latest
# 已经迁到 26.04，提前对齐」的思路主动改成 26.04，那是错的：CI 跟不跟最新走是卫生问题，
# 打包基线跟不跟最新走是产品问题，两者取舍相反。
# ① 产物：glibc 的版本化符号**单方向兼容** —— 新 glibc 必定保留全部旧版本标签（实测
#    2.43 的 libm 同时带 `log10f@GLIBC_2.2.5` 与 `log10f@@GLIBC_2.43`），所以 24.04 编的包
#    在所有更新的发行版上都能跑，**反过来不行**。CI 出的 deb/rpm/AppImage 是发给用户跑的，
#    基线就该压到支持范围里最老的一档。
# 下限就是 24.04 不是挑的：onnxruntime（ort）预编译包要求 glibc ≥ 2.39，正是 24.04 的
# 版本；再老编不过，这就是支持范围的实际下限（依赖定的）。
# **两个方向都实测过**（别再凭推理改这条）：
#    · 26.04 编的二进制要 `log10f@GLIBC_2.43`，装到 24.04 上 symbol lookup error 起不来；
#    · 24.04 编的二进制最高只要 `GLIBC_2.39`，拷到 26.04（glibc 2.43）上真能跑起来 ——
#      ld.so --list 全部可解析，/debug 第 2 秒返回 200，快照各段齐全。
# **只作为文档记录**：`runs-on:` 拿不到 `env` 上下文，所以工作流里是直接写死的，这个值
# 不会被谁自动读取 —— 换版本时要同时改 workflow 的 `runs-on` 与这里（曾经定义过却没人读，
# 是 AGENTS §2.7「唯一来源」最容易被钻空子的地方，故在此说明清楚）。
LINUX_RUNNER=ubuntu-24.04

# Android：JDK 大版本 + SDK 平台 / build-tools。
# 注意本工程**构建时不需要 NDK / CMake** —— 但原因不是「没有 JNI」：`libpvopus.so`
# （libopus 1.5.2 + `cpp/pv_opus.cpp` 的 JNI 转发层）是用 NDK **预编译并入库**的产物，
# 放在 `android/app/src/main/jniLibs/arm64-v8a/`，Gradle 不编译 native 代码。要重建那个
# .so 才需要 NDK + CMake（`tools/automation/build_opus_android.py`）。**勿在本项目里加 NDK。**
JDK_VER=17
ANDROID_PLATFORM=android-34
ANDROID_BUILD_TOOLS=34.0.0
