#!/bin/sh
# PureVox — 内嵌 Python 3.12 启动器
# 用法: ./py312 <python args...>   例如  ./py312 run_tk.py
set -e

APP_DIR="$(cd "$(dirname "$0")" && pwd)"
PY_BIN="$APP_DIR/packages/python312/bin/python3.12"

if [ ! -x "$PY_BIN" ]; then
    echo "PureVox: 未找到内嵌 Python 3.12，先运行 ./bootstrap_python312.sh" >&2
    exit 1
fi

# 让解释器找到自带的 libpython3.12.so（独立于系统环境）
export LD_LIBRARY_PATH="$APP_DIR/packages/python312/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$PY_BIN" "$@"
