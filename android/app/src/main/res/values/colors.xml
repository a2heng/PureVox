<resources>
    <!-- 品牌色（与桌面端深蓝一致） -->
    <color name="pv_blue">#1B3A63</color>
    <!-- pv_blue 上的文字色（暗色主题在 values-night 覆盖成深色，那边底色变亮蓝） -->
    <color name="pv_on_blue">#FFFFFF</color>
    <!-- 卡片标题 / 交互强调色：亮色主题用深蓝；暗色主题在 values-night/colors.xml 覆盖成亮蓝 -->
    <color name="pv_accent">#1B3A63</color>
    <!-- 电脑回 err / 本机故障：状态区红字行 -->
    <color name="pv_err">#C62828</color>

    <!--
      底色 / 卡片 / 输入框：**中性冷灰**三档，层次靠明度差，不靠阴影叠卡片。
      底 < 卡片 < 高亮面板（状态读数、输入框）。
    -->
    <color name="pv_bg">#F2F4F8</color>
    <color name="pv_surface">#FFFFFF</color>
    <color name="pv_surface_alt">#F7F9FC</color>
    <color name="pv_outline">#E2E7F0</color>
    <!-- 顶栏（品牌深蓝，与状态栏同色 → 看起来是一整块，不是「系统条 + 应用」两截） -->
    <color name="pv_header">#132C50</color>
    <color name="pv_header_light">#2C5C9F</color>
    <!-- 头图状态点：已连接 / 未连接 -->
    <color name="pv_dot_on">#7CE3A8</color>
    <color name="pv_dot_wait">#F0C46A</color>
    <color name="pv_dot_off">#B9C6DA</color>
    <!-- 弹窗背后遮罩（只在代码里用 dimAmount，这里留一个可读的常量） -->
    <color name="pv_scrim">#66000000</color>
</resources>
